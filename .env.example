# API CMS
PUBLIC_DIRECTUS_URL=your-directus-url
DIRECTUS_STATIC_TOKEN=your-directus-static-token
# Log levels (debug|info|warn|error): progressive human detail by CONFIGURED level — error=location only, warn=+path/code, info=+reason/ip, debug=+raw/key/stack. Never tokens/email plaintext.
DIRECTUS_LOG_LEVEL=your-directus-log-level

# VISUAL EDITING
DIRECTUS_PREVIEW_SECRET=your-directus-preview-secret
PUBLIC_ENABLE_VISUAL_EDITING=your-directus-enable-visual-editing

# CLOUDFARE TURNSTILE
PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
PUBLIC_SITEVERIFY_URL=your-cloudflare-siteverify-url

# ARCJET API SECURITY
ARCJET_KEY=your-arcjet-key
ARCJET_MODE=your-arcjet-mode
ARCJET_LOG_LEVEL=your-arcjet-log-level

# SECURITY LEVELS
RATE_LIMITER_LOG_LEVEL=your-rate-limiter-log-level
FILTER_LOG_LEVEL=your-filter-log-level
DEEP_EMAIL_VALIDATOR_LOG_LEVEL=your-deep-email-validator-log-level

# GOOGLE ANALYTICS
PUBLIC_GA_MEASUREMENT_ID=your-google-analytics-measurement-id

# MEILISEARCH
PUBLIC_MEILISEARCH_HOST=your-meilisearch-host
MEILISEARCH_API_KEY=your-meilisearch-api-key
MEILISEARCH_LOG_LEVEL=your-meilisearch-log-level

# CACHE DIRECTUS CMS
WEBHOOK_SECRET=your-webhook-secret
CACHE_LOG_LEVEL=your-cache-log-level

# WEBSITE URL
PUBLIC_WEBSITE_URL=your-website-url
